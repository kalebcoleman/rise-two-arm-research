                }
            )
        }

        def OmniGraphNode "state_pub"
        {
            custom uint64 inputs:context
            prepend uint64 inputs:context.connect = </Graph/ActionGraph_RG2/context.outputs:context>
            custom double[] inputs:effort
            custom uint inputs:execIn (
                customData = {
                    bool isExecution = 1
                }
            )
            prepend uint inputs:execIn.connect = </Graph/ActionGraph_RG2/tick.outputs:tick>
