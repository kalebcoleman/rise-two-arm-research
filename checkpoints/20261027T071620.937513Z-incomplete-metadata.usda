            custom uint64 outputs:context
        }

        def OmniGraphNode "target_sub"
        {
            custom uint64 inputs:context
            prepend uint64 inputs:context.connect = </Graph/ActionGraph_RG2/context.outputs:context>
            custom uint inputs:execIn (
