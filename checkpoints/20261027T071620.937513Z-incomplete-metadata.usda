    def Scope "Looks"
    {
        def Material "GreenTranslucent"
        {
            token outputs:mdl:displacement.connect = </World/Looks/GreenTranslucent/Shader.outputs:out>
            token outputs:mdl:surface.connect = </World/Looks/GreenTranslucent/Shader.outputs:out>
            token outputs:mdl:volume.connect = </World/Looks/GreenTranslucent/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                float inputs:albedo_add = 0
                float inputs:albedo_brightness = 1
                float inputs:ao_to_diffuse = 0
                color3f inputs:diffuse_color_constant = (0, 1, 0)
                bool inputs:enable_opacity = 1
                float inputs:metallic_constant = 0
                float inputs:opacity_constant = 0.3
                int inputs:opacity_mode = 1
                float inputs:opacity_threshold = 0
                float inputs:reflection_roughness_constant = 0.5
                float inputs:reflection_roughness_texture_influence = 0
                float inputs:specular_level = 0.5
                token outputs:out (
                    renderType = "material"
                )
            }
        }

        def Material "visual_material"
        {
            token outputs:surface.connect = </World/Looks/visual_material/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                float3 inputs:diffuseColor = (0.5, 0.5, 0.5)
                token outputs:surface
            }
        }
    }

