            custom double inputs:wrench:force:y
            custom double inputs:wrench:force:z
            custom double inputs:wrench:torque:x
            custom double inputs:wrench:torque:y
            custom double inputs:wrench:torque:z
            token node:type = "isaacsim.ros2.bridge.ROS2Publisher"
            int node:typeVersion = 1
            custom uint outputs:execOut (
                customData = {
